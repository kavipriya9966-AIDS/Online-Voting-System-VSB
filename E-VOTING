<script>
    // Live Ticker Simulation
    let precinctPct = 84.00;
    let vanceVotes = 1240402;
    let sterlingVotes = 1126890;

    function updateLiveStats() {
        // Slowly increase precincts
        if (precinctPct < 99.9) {
            precinctPct += Math.random() * 0.05;
            document.getElementById('precincts-reporting').innerText = precinctPct.toFixed(2);
        }

        // Ticker for votes
        const vanceIncr = Math.floor(Math.random() * 50);
        const sterlingIncr = Math.floor(Math.random() * 45);
        vanceVotes += vanceIncr;
        sterlingVotes += sterlingIncr;
        
        document.getElementById('vance-votes').innerText = vanceVotes.toLocaleString();
        document.getElementById('sterling-votes').innerText = sterlingVotes.toLocaleString();

        // Recalculate percentages
        const total = vanceVotes + sterlingVotes;
        const vPct = (vanceVotes / total) * 100;
        const sPct = 100 - vPct;

        document.getElementById('vance-percent').innerText = vPct.toFixed(1) + '%';
        document.getElementById('sterling-percent').innerText = sPct.toFixed(1) + '%';
        
        document.getElementById('vance-bar').style.width = vPct.toFixed(1) + '%';
        document.getElementById('sterling-bar').style.width = sPct.toFixed(1) + '%';

        // Update time-ago (simulation)
        const seconds = Math.floor(Date.now() / 1000) % 60;
        document.getElementById('time-ago').innerText = seconds < 10 ? 'just now' : seconds + ' seconds ago';
    }

    // Interval for live ticker
    setInterval(updateLiveStats, 3000);

    // Verification Explorer Logic
    function handleVerification() {
        const input = document.getElementById('hash-input');
        const btn = document.getElementById('verify-btn');
        const result = document.getElementById('verification-result');
        const originalText = btn.innerHTML;

        if (!input.value.trim()) return;

        // Loading state
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin">refresh</span><span>Verifying...</span>';
        btn.classList.add('opacity-80');
        result.classList.add('hidden');

        setTimeout(() => {
            // Success State
            btn.disabled = false;
            btn.innerHTML = originalText;
            btn.classList.remove('opacity-80');
            
            result.classList.remove('hidden');
            result.classList.add('animate-content');
            
            // Highlight result
            result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 1800);
    }

    // Initialize entrance animations properly
    window.addEventListener('DOMContentLoaded', () => {
        const contents = document.querySelectorAll('.animate-content');
        contents.forEach(el => {
            // Reset width of bars to 0 for initial entrance feel
            const bars = el.querySelectorAll('.chart-bar-transition');
            bars.forEach(bar => {
                const target = bar.style.width;
                bar.style.width = '0%';
                setTimeout(() => bar.style.width = target, 600);
            });
        });
    });
</script>
