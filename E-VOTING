<script>
        function selectCandidate(element) {
            // Remove selection from all cards
            document.querySelectorAll('.candidate-card').forEach(card => {
                card.classList.remove('selection-active');
            });
            
            // Add selection to clicked card
            element.classList.add('selection-active');
            
            // Enable submit button
            const submitBtn = document.getElementById('submit-btn');
            submitBtn.disabled = false;
            submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            
            // Subtle haptic feel (visual jump)
            element.style.transform = 'scale(0.98)';
            setTimeout(() => { element.style.transform = 'scale(1)'; }, 100);
        }

        document.getElementById('submit-btn').addEventListener('click', function() {
            if (this.disabled) return;
            
            const overlay = document.getElementById('loading-overlay');
            overlay.classList.remove('hidden');
            
            // Simulate processing
            setTimeout(() => {
                // In a real app, this would route to the Review page
                alert("Cryptographic proof generated. Proceeding to review...");
                overlay.classList.add('hidden');
            }, 2500);
        });

        // Add some basic keyboard accessibility
        document.querySelectorAll('.candidate-card').forEach(card => {
            card.setAttribute('tabindex', '0');
            card.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    selectCandidate(card);
                }
            });
        });
    </script>
